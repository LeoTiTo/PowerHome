<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <ImageView
            android:id="@+id/ivHabitatIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="Icône habitat"
            android:src="@drawable/ic_menu_habitat"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvHabitatName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:text="Nom de l'habitat"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/tvConsumption"
            app:layout_constraintStart_toEndOf="@+id/ivHabitatIcon"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvApartmentNumber"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:text="Appartement n°101"
            android:textSize="14sp"
            app:layout_constraintEnd_toStartOf="@+id/tvConsumption"
            app:layout_constraintStart_toEndOf="@+id/ivHabitatIcon"
            app:layout_constraintTop_toBottomOf="@+id/tvHabitatName" />

        <TextView
            android:id="@+id/tvResidentsCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="8dp"
            android:text="2 résidents"
            android:textSize="12sp"
            app:layout_constraintEnd_toStartOf="@+id/tvConsumption"
            app:layout_constraintStart_toEndOf="@+id/ivHabitatIcon"
            app:layout_constraintTop_toBottomOf="@+id/tvApartmentNumber" />

        <TextView
            android:id="@+id/tvConsumption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2500 W"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView> 