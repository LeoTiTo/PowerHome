<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.PowerHome" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Couleurs principales -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Couleurs secondaires -->
        <item name="colorSecondary">@color/colorAccent</item>
        <item name="colorSecondaryVariant">@color/colorPrimaryLight</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Couleur d'état (barres de statut, etc.) -->
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
        <!-- Fond d'écran légèrement teinté -->
        <item name="android:windowBackground">@color/colorBackground</item>
        <!-- Style de texte -->
        <item name="android:textColorPrimary">@color/black</item>
        <item name="android:textColorSecondary">#757575</item>
    </style>

    <style name="Theme.PowerHome" parent="Base.Theme.PowerHome" />

    <!-- Theme sans barre d'action pour les écrans de login -->
    <style name="Theme.PowerHome.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <!-- Style pour le Splash Screen -->
    <style name="SplashScreenTheme" parent="Theme.PowerHome.NoActionBar">
        <item name="android:windowBackground">@color/colorPrimary</item>
    </style>
    
    <!-- Styles pour les boutons -->
    <style name="Button.PowerHome" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/colorPrimary</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">8dp</item>
    </style>
    
    <!-- Style pour les cartes -->
    <style name="CardView.PowerHome" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/white</item>
        <item name="cardCornerRadius">8dp</item>
        <item name="cardElevation">4dp</item>
    </style>
</resources>